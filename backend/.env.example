# Copy to your shell / container environment. Double underscores map to nested
# configuration keys. NEVER commit real secrets — this file holds placeholders.

# PostgreSQL (production / Railway). Development uses an in-memory store and
# needs neither of these. Set EITHER an explicit Npgsql connection string:
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=virentum;Username=virentum;Password=virentum
# ...OR rely on Railway's DATABASE_URL (auto-converted to Npgsql format):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing (must be >= 32 chars)
Jwt__Issuer=https://api.virentum.app
Jwt__Audience=https://app.virentum.app
Jwt__Secret=replace-with-a-long-random-secret-min-32-chars

# Azure Custom Vision (set UseStub=false to call the real service)
CustomVision__UseStub=false
CustomVision__Endpoint=https://<region>.cognitiveservices.azure.com
CustomVision__PredictionKey=replace-with-prediction-key
CustomVision__ProjectId=replace-with-project-guid
CustomVision__PublishedModelName=replace-with-iteration-name

# Comma/array origins are configured in appsettings; override per environment:
# Cors__AllowedOrigins__0=https://app.virentum.app

# The one account a deployed instance may seed, for a public demo. Both halves
# are required and neither has a default: leave them unset and no account is
# created, which is what stops an API from handing out a login on its own.
# Development seeds demo-store/changeit without these.
# DemoAccount__StoreId=demo-store
# DemoAccount__Password=replace-with-a-real-password
# DemoAccount__DisplayName=Demo Operator
# DemoAccount__Station=Demo station
