{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=Virentum;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "https://localhost:5001",
    "Audience": "https://localhost:5001",
    "_secretNote": "Dev-only signing key. NEVER reuse in production — set Jwt__Secret via env var / user-secrets there.",
    "Secret": "dev-only-insecure-signing-key-change-me-32chars+",
    "AccessTokenLifetimeMinutes": 120
  },
  "CustomVision": {
    "UseStub": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  }
}
